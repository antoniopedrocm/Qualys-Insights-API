{
  "Qualys": {
    "BaseUrl": "https://qualysguard.qg3.apps.qualys.com",
    "Username": "",
    "Password": "",
    "TimeoutSeconds": 120,
    "MaxKnowledgeBaseConcurrency": 3,
    "KnowledgeBaseBatchSize": 30,
    "MaxTransientRetries": 3
  },
  "Cache": {
    "DefaultTtlSeconds": 300,
    "AllowStaleOnFailure": true
  },
  "Storage": {
    "DataDirectory": "C:\\ProgramData\\QualysInsights",
    "DatabaseFileName": "qualys-insights.db",
    "LegacyEffectivenessCachePath": "data\\effectiveness-cache.json",
    "MigrateLegacyJsonOnStartup": true,
    "DetectionIdsCsvPath": "legacy-node\\detection_ids.csv"
  },
  "Authentication": {
    "Mode": "Windows",
    "AllowedActiveDirectoryGroups": [],
    "ApiKeySha256": ""
  },
  "Export": {
    "MaxRows": 250000
  },
  "RateLimit": {
    "PermitLimit": 20,
    "WindowSeconds": 60
  },
  "Hosting": {
    "PathBase": "",
    "MaxRequestBodyBytes": 1048576
  },
  "BackgroundRefresh": {
    "Enabled": false,
    "IntervalMinutes": 30
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "SecurityHeaders": {
    "ContentSecurityPolicy": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
